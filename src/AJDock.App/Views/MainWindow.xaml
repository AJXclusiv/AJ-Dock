<Window x:Class="AJDock.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AJDock.App.ViewModels"
        Title="AJ Dock"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/Assets/AJDock.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="{Binding Settings.AlwaysOnTop}">
    <Grid x:Name="DockRoot"
          MinWidth="320"
          AllowDrop="True"
          SnapsToDevicePixels="True"
          ClipToBounds="False"
          DragEnter="DockShell_DragEnter"
          Drop="DockShell_Drop"
          MouseEnter="DockShell_MouseEnter"
          MouseLeave="DockShell_MouseLeave"
          MouseMove="DockShell_MouseMove">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="DockStartupTransform" Y="0" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="DockHeadroomRow" Height="0" />
            <RowDefinition x:Name="DockChromeRow" Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="DockChrome"
                Grid.Row="1"
                Height="50"
                Margin="448,0"
                VerticalAlignment="Center"
                CornerRadius="0"
                BorderThickness="0"
                Background="Transparent"
                AllowDrop="True"
                ClipToBounds="False" />

        <Grid x:Name="OuterLeftSpectrum"
              Grid.Row="1"
              Width="420"
              Height="82"
              Margin="16,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              IsHitTestVisible="False"
              ClipToBounds="False">
            <Polyline x:Name="SpotifyLeftSpectrumGlow"
                      Stroke="#FF93F7FF"
                      StrokeThickness="1.65"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Opacity="0" />
            <Polyline x:Name="SpotifyLeftSpectrumEcho"
                      Stroke="#FFFFFFFF"
                      StrokeThickness="1.45"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Opacity="0" />
            <Polyline x:Name="SpotifyLeftSpectrum"
                      Stroke="#FFFFFFFF"
                      StrokeThickness="2.1"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
        </Grid>

        <Grid x:Name="OuterRightSpectrum"
              Grid.Row="1"
              Width="420"
              Height="82"
              Margin="0,0,16,0"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              IsHitTestVisible="False"
              ClipToBounds="False">
            <Polyline x:Name="SpotifyRightSpectrumGlow"
                      Stroke="#FF93F7FF"
                      StrokeThickness="1.65"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Opacity="0" />
            <Polyline x:Name="SpotifyRightSpectrumEcho"
                      Stroke="#FFFFFFFF"
                      StrokeThickness="1.45"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Opacity="0" />
            <Polyline x:Name="SpotifyRightSpectrum"
                      Stroke="#FFFFFFFF"
                      StrokeThickness="2.1"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
        </Grid>

        <Grid x:Name="DockContent"
              Grid.Row="1"
              Margin="458,0"
              VerticalAlignment="Center"
              Background="Transparent"
              AllowDrop="True"
              ClipToBounds="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid VerticalAlignment="Center" Margin="0,0,10,0">
                <Button x:Name="StartMenuButton"
                        Width="{Binding Settings.IconSize}"
                        Height="{Binding Settings.IconSize}"
                        Style="{StaticResource IconButtonStyle}"
                        VerticalAlignment="Center"
                        Command="{Binding OpenWindowsStartCommand}"
                        PreviewMouseLeftButtonDown="StartMenuButton_PreviewMouseLeftButtonDown"
                        ToolTip="Windows Start">
                    <Grid>
                        <Ellipse Fill="#234C8AFF" Opacity="0.38" />
                        <TextBlock Text="&#xE80F;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="{Binding Settings.IconSize, Converter={StaticResource ScaleValueConverter}, ConverterParameter=0.82}"
                                   Foreground="#F5FBFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Popup IsOpen="{Binding IsStartMenuOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=StartMenuButton}"
                       Placement="Top"
                       VerticalOffset="-12"
                       HorizontalOffset="-6"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       PopupAnimation="Fade">
                    <Border Width="430"
                            MaxHeight="600"
                            CornerRadius="16"
                            Padding="16"
                            Background="#F20D141B"
                            BorderBrush="#25394F60"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="12" Opacity="0.38" Color="#050A0E" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="12"
                                        Background="#1D73DFFF">
                                    <TextBlock Text="&#xE80F;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="20"
                                               Foreground="#F5FBFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="AJ Dock"
                                               Foreground="#F6FBFF"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Start"
                                               Foreground="#86A1B4"
                                               FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1"
                                    Height="40"
                                    Margin="0,14,0,0"
                                    CornerRadius="10"
                                    Background="#6817222D"
                                    BorderBrush="#1EFFFFFF"
                                    BorderThickness="1"
                                    Padding="12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;"
                                               FontFamily="Segoe Fluent Icons"
                                               Foreground="#7FA4BC"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding StartMenuSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#F4FAFF"
                                             CaretBrush="#8CCAFF"
                                             FontSize="13"
                                             VerticalContentAlignment="Center" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dock Pins"
                                           Foreground="#DDEEFF"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding OpenSettingsCommand}"
                                        ToolTip="Settings">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#BFE1FF" Margin="0,0,7,0" />
                                        <TextBlock Text="Settings" Foreground="#BFE1FF" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="3"
                                          Margin="0,10,0,0"
                                          MaxHeight="390"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="88"
                                                        Height="76"
                                                        Margin="0,0,10,10"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <Image Source="{Binding Icon}" Width="34" Height="34" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant" />
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Foreground="#EFF8FF"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextAlignment="Center"
                                                                   Margin="0,7,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Apps"
                                               Foreground="#DDEEFF"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,8" />
                                    <ItemsControl ItemsSource="{Binding StartMenuApps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Height="42"
                                                        Margin="0,0,0,4"
                                                        HorizontalContentAlignment="Stretch"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Command="{Binding DataContext.OpenStartMenuAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="{Binding Icon}" Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant" Margin="4,0,11,0" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DisplayName}"
                                                                   Foreground="#F2F9FF"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Row="4" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ConnectionName}"
                                           Foreground="#7893A4"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding OpenWindowsAppsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#BFE1FF" Margin="0,0,7,0" />
                                        <TextBlock Text="Windows Apps" Foreground="#BFE1FF" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>

            <ItemsControl x:Name="DockItems" Grid.Column="1" ItemsSource="{Binding Items}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DockItemViewModel}">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Width="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                Height="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="{Binding DataContext.Settings.IconSpacing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SpacingToThicknessConverter}}"
                                RenderTransformOrigin="0.5,1"
                                Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                AllowDrop="True"
                                SnapsToDevicePixels="False"
                                UseLayoutRounding="False"
                                MouseEnter="DockItem_MouseEnter"
                                MouseLeave="DockItem_MouseLeave"
                                PreviewMouseLeftButtonDown="DockItem_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="DockItem_PreviewMouseMove"
                                DragOver="DockItem_DragOver"
                                Drop="DockItem_Drop">
                            <Button.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                    <TranslateTransform X="0" Y="0" />
                                </TransformGroup>
                            </Button.RenderTransform>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Style="{StaticResource DockMenuItem}"
                                              Command="{Binding PlacementTarget.Tag.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Open" /></StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Style="{StaticResource DockMenuItem}"
                                              Command="{Binding PlacementTarget.Tag.RunAsAdminCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Run as administrator" /></StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <Separator Visibility="{Binding PlacementTarget.DataContext.HasMiniControls, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <MenuItem Style="{StaticResource DockMenuItem}"
                                              Visibility="{Binding PlacementTarget.DataContext.HasMiniControls, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Mini controls" /></StackPanel>
                                        </MenuItem.Header>
                                        <MenuItem Style="{StaticResource DockMenuItem}"
                                                  Visibility="{Binding PlacementTarget.DataContext.IsBrowser, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  Command="{Binding PlacementTarget.Tag.OpenBrowserWindowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="New window" /></StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Style="{StaticResource DockMenuItem}"
                                                  Visibility="{Binding PlacementTarget.DataContext.IsBrowser, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  Command="{Binding PlacementTarget.Tag.OpenBrowserPrivateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Private window" /></StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Style="{StaticResource DockMenuItem}"
                                                  Visibility="{Binding PlacementTarget.DataContext.IsVsCode, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  Command="{Binding PlacementTarget.Tag.OpenVsCodeWindowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="New VS Code window" /></StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Style="{StaticResource DockMenuItem}"
                                                  Visibility="{Binding PlacementTarget.DataContext.IsDiscord, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  Command="{Binding PlacementTarget.Tag.DiscordMuteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Toggle Discord mute" /></StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Style="{StaticResource DockMenuItem}"
                                                  Visibility="{Binding PlacementTarget.DataContext.IsDiscord, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  Command="{Binding PlacementTarget.Tag.DiscordDeafenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F6;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Toggle Discord deafen" /></StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <Separator Visibility="{Binding PlacementTarget.DataContext.SupportsMediaControls, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <MenuItem Style="{StaticResource DockMenuItem}"
                                                  Visibility="{Binding PlacementTarget.DataContext.SupportsMediaControls, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  Command="{Binding PlacementTarget.Tag.SpotifyPreviousCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Previous" /></StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Style="{StaticResource DockMenuItem}"
                                                  Visibility="{Binding PlacementTarget.DataContext.SupportsMediaControls, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  Command="{Binding PlacementTarget.Tag.SpotifyPlayPauseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Play / Pause" /></StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Style="{StaticResource DockMenuItem}"
                                                  Visibility="{Binding PlacementTarget.DataContext.SupportsMediaControls, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  Command="{Binding PlacementTarget.Tag.SpotifyNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Next" /></StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Style="{StaticResource DockMenuItem}"
                                              Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="{Binding PlacementTarget.DataContext.PinActionText, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /></StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Style="{StaticResource DockMenuItem}"
                                              Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Open file location" /></StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Style="{StaticResource DockMenuItem}"
                                              Command="{Binding PlacementTarget.Tag.ChooseCustomIconCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Choose custom icon" /></StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Style="{StaticResource DockMenuItem}"
                                              Command="{Binding PlacementTarget.Tag.ToggleEditModeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="{Binding PlacementTarget.Tag.EditModeText, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /></StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Style="{StaticResource DockMenuItem}"
                                              Command="{Binding PlacementTarget.Tag.CloseApplicationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" Width="22" Foreground="#FF5B67" /><TextBlock Text="Close application" /></StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Grid>
                                <Border Tag="DockItemHoverBackplate"
                                        Width="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CornerRadius="12"
                                        Background="#10FFFFFF"
                                        BorderBrush="#18FFFFFF"
                                        BorderThickness="1"
                                        Opacity="0"
                                        CacheMode="BitmapCache"
                                        IsHitTestVisible="False" />
                                <Border Tag="DockItemHoverSheen"
                                        Width="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CornerRadius="12"
                                        Opacity="0"
                                        CacheMode="BitmapCache"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#38FFFFFF" Offset="0" />
                                            <GradientStop Color="#08FFFFFF" Offset="0.42" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Image Source="{Binding Icon}"
                                       Width="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Height="{Binding DataContext.Settings.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="False"
                                       UseLayoutRounding="False" />
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="#9CF8FF"
                                         Stroke="#E8FFFFFF"
                                         StrokeThickness="1"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,0,-5"
                                         Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="9" ShadowDepth="0" Color="#42DDFB" Opacity="0.9" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Border Width="18"
                                        Height="18"
                                        CornerRadius="9"
                                        Background="#E7248CFF"
                                        BorderBrush="#D8FFFFFF"
                                        BorderThickness="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-5,-5,0"
                                        Visibility="{Binding HasStack, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding StackCount}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Border MinWidth="18"
                                        Height="18"
                                        CornerRadius="9"
                                        Background="#E7FF375F"
                                        BorderBrush="#E8FFFFFF"
                                        BorderThickness="1"
                                        Padding="5,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="-5,-5,0,0"
                                        Visibility="{Binding HasNotificationBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding NotificationBadgeText}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Border Width="17"
                                        Height="17"
                                        CornerRadius="8.5"
                                        Background="#F42B3340"
                                        BorderBrush="#FFFF7589"
                                        BorderThickness="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-7,-7,0"
                                        Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="&#xE738;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="8"
                                               Foreground="#FFFFDCE3"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Popup x:Name="DockHoverLabelPopup"
                   Placement="Top"
                   VerticalOffset="-9"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   PopupAnimation="Fade">
                <Border CornerRadius="9"
                        Padding="10,5"
                        Background="#E9091118"
                        BorderBrush="#2AFFFFFF"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.34" Color="#02070A" />
                    </Border.Effect>
                    <TextBlock x:Name="DockHoverLabelText"
                               Foreground="#F6FBFF"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap" />
                </Border>
            </Popup>

            <Popup IsOpen="{Binding IsPreviewOpen, Mode=TwoWay}"
                   PlacementTarget="{Binding ElementName=DockItems}"
                   Placement="Top"
                   VerticalOffset="-46"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   PopupAnimation="Fade"
                   MouseEnter="WindowPreviewPopup_MouseEnter"
                   MouseLeave="WindowPreviewPopup_MouseLeave">
                <Border MaxWidth="1120"
                        CornerRadius="18"
                        Padding="14"
                        BorderBrush="#315B7590"
                        BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#EF172231" Offset="0" />
                            <GradientStop Color="#E60A1018" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="34" ShadowDepth="14" Opacity="0.42" Color="#03080D" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{Binding PreviewTitle}"
                                   Foreground="#F5FBFF"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="5,0,0,12" />
                        <ItemsControl ItemsSource="{Binding WindowPreviews}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="320"
                                            Height="228"
                                            CornerRadius="14"
                                            Margin="5"
                                            BorderBrush="#34FFFFFF"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#7A263746" Offset="0" />
                                                <GradientStop Color="#48101820" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="8" Opacity="0.24" Color="#03070B" />
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="176" />
                                                <RowDefinition Height="52" />
                                            </Grid.RowDefinitions>
                                            <Button Grid.RowSpan="2"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Command="{Binding DataContext.ActivatePreviewWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Open window" />
                                            <Grid Background="#0D151D"
                                                  IsHitTestVisible="False">
                                                <Image Source="{Binding PreviewImage}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="Fant" />
                                                <Border VerticalAlignment="Bottom"
                                                        Height="58"
                                                        IsHitTestVisible="False">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00101820" Offset="0" />
                                                            <GradientStop Color="#B20A1018" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Image Source="{Binding FallbackIcon}"
                                                       Width="62"
                                                       Height="62"
                                                       Stretch="Uniform"
                                                       Opacity="0.22"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding FallbackIcon}"
                                                           Width="22"
                                                           Height="22"
                                                           Margin="0,0,9,0"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="Fant" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               Foreground="#F4FAFF"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Width="26" Height="28" Background="#1F6EA8D8" Style="{StaticResource IconButtonStyle}" Command="{Binding DataContext.RestorePreviewWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Restore">
                                                        <TextBlock Text="&#xE923;" FontFamily="Segoe Fluent Icons" Foreground="#BFE1FF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                    <Button Width="26" Height="28" Background="#1F6EA8D8" Style="{StaticResource IconButtonStyle}" Command="{Binding DataContext.MinimizePreviewWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Minimize">
                                                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" Foreground="#BFE1FF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                    <Button Width="26" Height="28" Background="#1F6EA8D8" Style="{StaticResource IconButtonStyle}" Command="{Binding DataContext.SnapPreviewLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Snap left">
                                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons" Foreground="#BFE1FF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                    <Button Width="26" Height="28" Background="#1F6EA8D8" Style="{StaticResource IconButtonStyle}" Command="{Binding DataContext.SnapPreviewRightCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Snap right">
                                                        <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons" Foreground="#BFE1FF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                    <Button Width="26" Height="28" Background="#1F6EA8D8" Style="{StaticResource IconButtonStyle}" Command="{Binding DataContext.PinPreviewWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Pin to dock">
                                                        <TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons" Foreground="#BFE1FF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                    <Button Width="26" Height="28" Background="#2AFF375F" Style="{StaticResource IconButtonStyle}" Command="{Binding DataContext.ClosePreviewWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Close window">
                                                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" Foreground="#FF7282" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>

            <Border Grid.Column="2"
                    x:Name="SpotifyPod"
                    CornerRadius="15"
                    BorderThickness="1"
                    Padding="7,5"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    ClipToBounds="True"
                    Visibility="{Binding IsSpotifyActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D10B1711" Offset="0" />
                        <GradientStop Color="#C71B5C36" Offset="0.55" />
                        <GradientStop Color="#D508100C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#AB9CFFD0" Offset="0" />
                        <GradientStop Color="#401DB954" Offset="0.58" />
                        <GradientStop Color="#26101216" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.42" Color="#1DB954" />
                </Border.Effect>
                <Grid>
                    <Image Source="{Binding SpotifyArtwork}"
                           Stretch="UniformToFill"
                           Opacity="0.58"
                           IsHitTestVisible="False" />
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#EF06110C" Offset="0" />
                                <GradientStop Color="#A8144F31" Offset="0.48" />
                                <GradientStop Color="#EA06110C" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Width="326" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="34" Height="34" VerticalAlignment="Center">
                            <Ellipse Fill="#D908120C" Stroke="#879CFFD0" StrokeThickness="1" />
                            <Ellipse Width="22" Height="22" Fill="#1DB954" Opacity="0.92" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Width="7" Height="7" Fill="#07100B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Column="1" Margin="8,0,10,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding SpotifyTrackText}"
                                       Foreground="#F4FFF8"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1"
                                       Text="{Binding SpotifyArtistText}"
                                       Foreground="#B4F4CA"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,1,0,0" />
                            <Grid Grid.Row="2" Margin="0,3,0,0">
                                <Border Height="2" CornerRadius="1" Background="#38FFFFFF" />
                                <Border Width="72" Height="2" CornerRadius="1" HorizontalAlignment="Left" Background="#D51DB954" />
                            </Grid>
                        </Grid>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Width="28"
                                    Height="28"
                                    Style="{StaticResource AnimatedMediaButtonStyle}"
                                    Command="{Binding SpotifyPreviousCommand}"
                                    ToolTip="Previous">
                                <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons" Foreground="#EFFFF5" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button Width="32"
                                    Height="30"
                                    Margin="3,0"
                                    Style="{StaticResource AnimatedMediaButtonStyle}"
                                    Command="{Binding SpotifyPlayPauseCommand}"
                                    ToolTip="{Binding MediaPlayPauseToolTip}">
                                <Border Width="30" Height="28" CornerRadius="14" Background="#E81DB954" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard Name="MediaPlayingPulse">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.72" />
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.72" />
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.86" Duration="0:0:0.72" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="MediaPlayingPulse" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding MediaPlayPauseGlyph}" FontFamily="Segoe Fluent Icons" Foreground="#07100B" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Button>
                            <Button Width="28"
                                    Height="28"
                                    Style="{StaticResource AnimatedMediaButtonStyle}"
                                    Command="{Binding SpotifyNextCommand}"
                                    ToolTip="Next">
                                <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons" Foreground="#EFFFF5" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="3"
                  VerticalAlignment="Center"
                  Margin="12,0,0,0"
                  Visibility="{Binding ClockVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="WifiButton"
                        Grid.Column="4"
                        Width="28"
                        Height="32"
                        Margin="7,0,0,0"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding ToggleWifiPopoverCommand}"
                        ToolTip="{Binding ConnectionName}">
                    <TextBlock Text="&#xE701;"
                               FontFamily="Segoe Fluent Icons"
                               Foreground="#BCD5E8"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>

                <Border Grid.Column="0" Width="1" Height="28" Background="#38FFFFFF" Margin="0,0,7,0" />

                <Button x:Name="CaffeineButton"
                        Grid.Column="1"
                        Width="30"
                        Height="32"
                        Margin="0,0,5,0"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding ToggleCaffeineCommand}"
                        ToolTip="{Binding CaffeineStatusText}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Style="{StaticResource DockMenuItem}"
                                      Command="{Binding PlacementTarget.DataContext.SetCaffeineActiveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="true">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Active" /></StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Style="{StaticResource DockMenuItem}"
                                      Command="{Binding PlacementTarget.DataContext.SetCaffeineActiveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="false">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE769;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Inactive" /></StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <Separator />
                            <MenuItem Style="{StaticResource DockMenuItem}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Active for" /></StackPanel>
                                </MenuItem.Header>
                                <MenuItem Style="{StaticResource DockMenuItem}" Header="15 minutes" Command="{Binding PlacementTarget.DataContext.SetCaffeineActiveForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="15" />
                                <MenuItem Style="{StaticResource DockMenuItem}" Header="30 minutes" Command="{Binding PlacementTarget.DataContext.SetCaffeineActiveForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="30" />
                                <MenuItem Style="{StaticResource DockMenuItem}" Header="1 hour" Command="{Binding PlacementTarget.DataContext.SetCaffeineActiveForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="60" />
                                <MenuItem Style="{StaticResource DockMenuItem}" Header="10 hours" Command="{Binding PlacementTarget.DataContext.SetCaffeineActiveForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="600" />
                            </MenuItem>
                            <MenuItem Style="{StaticResource DockMenuItem}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Inactive for" /></StackPanel>
                                </MenuItem.Header>
                                <MenuItem Style="{StaticResource DockMenuItem}" Header="15 minutes" Command="{Binding PlacementTarget.DataContext.SetCaffeineInactiveForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="15" />
                                <MenuItem Style="{StaticResource DockMenuItem}" Header="30 minutes" Command="{Binding PlacementTarget.DataContext.SetCaffeineInactiveForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="30" />
                                <MenuItem Style="{StaticResource DockMenuItem}" Header="1 hour" Command="{Binding PlacementTarget.DataContext.SetCaffeineInactiveForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="60" />
                            </MenuItem>
                            <MenuItem Style="{StaticResource DockMenuItem}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Exit timer" /></StackPanel>
                                </MenuItem.Header>
                                <MenuItem Style="{StaticResource DockMenuItem}" Header="30 minutes" Command="{Binding PlacementTarget.DataContext.SetCaffeineExitAfterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="30" />
                                <MenuItem Style="{StaticResource DockMenuItem}" Header="1 hour" Command="{Binding PlacementTarget.DataContext.SetCaffeineExitAfterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="60" />
                                <MenuItem Style="{StaticResource DockMenuItem}" Header="2 hours" Command="{Binding PlacementTarget.DataContext.SetCaffeineExitAfterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="120" />
                            </MenuItem>
                            <MenuItem Style="{StaticResource DockMenuItem}"
                                      Command="{Binding PlacementTarget.DataContext.ClearCaffeineTimersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Clear timers" /></StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <Separator />
                            <MenuItem Style="{StaticResource DockMenuItem}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Keep-awake method" /></StackPanel>
                                </MenuItem.Header>
                                <MenuItem Style="{StaticResource DockMenuItem}" Header="F15 key pulse" Command="{Binding PlacementTarget.DataContext.SetCaffeineMethodCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="F15Key" />
                                <MenuItem Style="{StaticResource DockMenuItem}" Header="Shift key pulse" Command="{Binding PlacementTarget.DataContext.SetCaffeineMethodCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="ShiftKey" />
                                <MenuItem Style="{StaticResource DockMenuItem}" Header="Windows stay-awake API" Command="{Binding PlacementTarget.DataContext.SetCaffeineMethodCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="WindowsStayAwake" />
                                <MenuItem Style="{StaticResource DockMenuItem}" Header="Allow screensaver" Command="{Binding PlacementTarget.DataContext.SetCaffeineMethodCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="AllowScreensaver" />
                            </MenuItem>
                            <MenuItem Style="{StaticResource DockMenuItem}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Pulse interval" /></StackPanel>
                                </MenuItem.Header>
                                <MenuItem Style="{StaticResource DockMenuItem}" Header="30 seconds" Command="{Binding PlacementTarget.DataContext.SetCaffeineIntervalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="30" />
                                <MenuItem Style="{StaticResource DockMenuItem}" Header="59 seconds" Command="{Binding PlacementTarget.DataContext.SetCaffeineIntervalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="59" />
                                <MenuItem Style="{StaticResource DockMenuItem}" Header="2 minutes" Command="{Binding PlacementTarget.DataContext.SetCaffeineIntervalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="120" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Style="{StaticResource DockMenuItem}"
                                      Command="{Binding PlacementTarget.DataContext.LaunchOriginalCaffeineCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons" Width="22" /><TextBlock Text="Launch original Caffeine" /></StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Style="{StaticResource DockMenuItem}"
                                      Command="{Binding PlacementTarget.DataContext.StopOriginalCaffeineCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" Width="22" Foreground="#FF5B67" /><TextBlock Text="Exit original Caffeine" /></StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Grid>
                        <Viewbox Width="18"
                                 Height="18"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M5,8 L16,8 L16,13 C16,15.2 14.2,17 12,17 L9,17 C6.8,17 5,15.2 5,13 Z M16,10 L18,10 C19.1,10 20,10.9 20,12 C20,13.1 19.1,14 18,14 L16,14 M7,20 L17,20 M8,5 C7.4,4.2 7.4,3.3 8,2.5 M12,5 C11.4,4.2 11.4,3.3 12,2.5"
                                      Stroke="#F8F2E9"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent" />
                            </Canvas>
                        </Viewbox>
                        <Ellipse Width="5"
                                 Height="5"
                                 Fill="#87FFB0"
                                 Stroke="#E8FFFFFF"
                                 StrokeThickness="0.8"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,4"
                                 Visibility="{Binding IsCaffeineKeepingAwake, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#42FF8A" Opacity="0.8" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                </Button>

                <Button x:Name="SystemClusterButton"
                        Grid.Column="2"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding ToggleSystemPopoverCommand}"
                        Padding="0"
                        ToolTip="Calendar and world clocks">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ClockText}"
                                   Foreground="#EEF8FF"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap" />
                        <Border CornerRadius="9"
                                Padding="7,2"
                                Margin="8,0,0,0"
                                Background="#182E4F68"
                                BorderBrush="#2B88D8FF"
                                BorderThickness="1">
                            <TextBlock Text="{Binding WeatherText}"
                                       Foreground="#D8F0FF"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>
                </Button>

                <Button x:Name="SoundButton"
                        Grid.Column="3"
                        Width="28"
                        Height="32"
                        Margin="7,0,0,0"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding ToggleVolumePopoverCommand}"
                        ToolTip="Volume">
                    <TextBlock Text="&#xE995;"
                               FontFamily="Segoe Fluent Icons"
                               Foreground="#C8D8E5"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>

                <Popup IsOpen="{Binding IsWifiPopoverOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=WifiButton}"
                       Placement="Top"
                       VerticalOffset="-10"
                       HorizontalOffset="-260"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       PopupAnimation="Fade">
                    <Border Width="300"
                            CornerRadius="14"
                            Padding="16"
                            Background="#F0111820"
                            BorderBrush="#263B5264"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="10" Opacity="0.36" Color="#050B10" />
                        </Border.Effect>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="21"
                                        Background="#1B6FD6FF"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="&#xE701;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="18"
                                               Foreground="#EAF7FF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConnectionName}"
                                               Foreground="#F6FBFF"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding NetworkAdapterName}"
                                               Foreground="#87A1B2"
                                               FontSize="11"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="9" Background="#351E9B63" Padding="10,8" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="Down" Foreground="#8DB7A7" FontSize="10" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DownloadRateText}" Foreground="#EAFBF4" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="9" Background="#342D71E8" Padding="10,8" Margin="5,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Up" Foreground="#9DAFE8" FontSize="10" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding UploadRateText}" Foreground="#EEF3FF" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border CornerRadius="10"
                                    Background="#58111B25"
                                    BorderBrush="#1DFFFFFF"
                                    BorderThickness="1"
                                    Padding="12"
                                    Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding WifiSpeedTestText}"
                                               Foreground="#DDEEFF"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding RunWifiSpeedTestCommand}"
                                            Margin="10,0,0,0">
                                        <Border CornerRadius="8" Background="#273A4A" Padding="10,6">
                                            <TextBlock Text="{Binding SpeedTestButtonText}"
                                                       Foreground="#BFE1FF"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Button>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding AvailableWifiNetworks}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                Command="{Binding DataContext.ConnectWifiNetworkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,0,6">
                                            <Border CornerRadius="9"
                                                    Background="#311D2B36"
                                                    Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE701;"
                                                               FontFamily="Segoe Fluent Icons"
                                                               Foreground="#BFE1FF"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,9,0" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Ssid}"
                                                                   Foreground="#F2FAFF"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Summary}"
                                                                   Foreground="#89A2B4"
                                                                   FontSize="10"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <UniformGrid Columns="3" Margin="0,12,0,0">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding OpenAvailableNetworksCommand}"
                                        Margin="0,0,5,0">
                                    <Border CornerRadius="8" Background="#243647" Padding="8,7">
                                        <TextBlock Text="Select" Foreground="#EAF7FF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding OpenWifiSettingsCommand}"
                                        Margin="5,0">
                                    <Border CornerRadius="8" Background="#243647" Padding="8,7">
                                        <TextBlock Text="Settings" Foreground="#EAF7FF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding ToggleWifiPowerCommand}"
                                        Margin="5,0,0,0">
                                    <Border CornerRadius="8" Background="#3A2430" Padding="8,7">
                                        <TextBlock Text="{Binding WifiPowerActionText}" Foreground="#FFDDE6" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </Border>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup IsOpen="{Binding IsVolumePopoverOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=SoundButton}"
                       Placement="Top"
                       VerticalOffset="-10"
                       HorizontalOffset="-218"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       PopupAnimation="Fade">
                    <Border Width="390"
                            CornerRadius="18"
                            Padding="16"
                            Background="#F20B1219"
                            BorderBrush="#365E7D92"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="34" ShadowDepth="12" Opacity="0.42" Color="#03080D" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Sound"
                                               Foreground="#F7FBFF"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Output, app mix, and audio line response"
                                               Foreground="#89A2B4"
                                               FontSize="11"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Width="34"
                                        Height="32"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding OpenSoundSettingsCommand}"
                                        ToolTip="Sound settings">
                                    <Border Width="30" Height="28" CornerRadius="10" Background="#203447">
                                        <TextBlock Text="&#xE713;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   Foreground="#BFE1FF"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1"
                                    CornerRadius="15"
                                    Margin="0,14,0,0"
                                    Padding="14"
                                    Background="#64122430"
                                    BorderBrush="#224D6A7D"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="124" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="112"
                                          Height="112"
                                          HorizontalAlignment="Left">
                                        <Ellipse Fill="#101E29"
                                                 Stroke="#1DFFFFFF"
                                                 StrokeThickness="1" />
                                        <Ellipse Width="94"
                                                 Height="94"
                                                 Fill="#132637"
                                                 Stroke="#3A8FD8FF"
                                                 StrokeThickness="1.5"
                                                 Opacity="0.95" />
                                        <Ellipse Width="68"
                                                 Height="68"
                                                 Fill="#0B141C"
                                                 Stroke="#182E4052"
                                                 StrokeThickness="1" />
                                        <Canvas Width="112" Height="112">
                                            <Border Width="5"
                                                    Height="42"
                                                    CornerRadius="3"
                                                    Background="#BFEAFF"
                                                    Canvas.Left="53.5"
                                                    Canvas.Top="15"
                                                    RenderTransformOrigin="0.5,0.96">
                                                <Border.RenderTransform>
                                                    <RotateTransform Angle="{Binding VolumeDialAngle}" />
                                                </Border.RenderTransform>
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.86" Color="#58C7FF" />
                                                </Border.Effect>
                                            </Border>
                                        </Canvas>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VolumePercentText}"
                                                       Foreground="#F5FBFF"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Output"
                                                       Foreground="#81A1B6"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Master volume"
                                                       Foreground="#DDEEFF"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding VolumePercentText}"
                                                       Foreground="#91BCD6"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                        <Slider Minimum="0"
                                                Maximum="100"
                                                Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TickFrequency="1" />

                                        <Grid Margin="0,14,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Audio line sensitivity"
                                                       Foreground="#DDEEFF"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding AudioVisualizerSensitivityText}"
                                                       Foreground="#91BCD6"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                        <Slider Minimum="0.2"
                                                Maximum="1.5"
                                                TickFrequency="0.05"
                                                Value="{Binding AudioVisualizerSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,14,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="App Mix"
                                           Foreground="#F2FAFF"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Per-app"
                                           Foreground="#7994A8"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <ScrollViewer Grid.Row="3"
                                          MaxHeight="190"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AudioSessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12"
                                                    Background="#4F101A23"
                                                    BorderBrush="#1DFFFFFF"
                                                    BorderThickness="1"
                                                    Padding="11,9"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="28"
                                                            Height="28"
                                                            CornerRadius="9"
                                                            Background="#1B2D3B"
                                                            Margin="0,0,10,0">
                                                        <TextBlock Text="&#xE8D6;"
                                                                   FontFamily="Segoe Fluent Icons"
                                                                   Foreground="#A8DFFF"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Foreground="#F2FAFF"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding VolumePercent, StringFormat={}{0:F0}%}"
                                                                   Foreground="#7F98AB"
                                                                   FontSize="10"
                                                                   Margin="0,1,0,0" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2"
                                                              Content="Mute"
                                                              Margin="10,0,0,0"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding IsMuted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Slider Grid.Row="1"
                                                            Grid.ColumnSpan="3"
                                                            Margin="0,8,0,0"
                                                            Minimum="0"
                                                            Maximum="100"
                                                            Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            TickFrequency="1" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Popup>

                <Popup IsOpen="{Binding IsSystemPopoverOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=SystemClusterButton}"
                       Placement="Top"
                       VerticalOffset="-10"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       PopupAnimation="Fade">
                    <Border Width="320"
                            CornerRadius="12"
                            Padding="16"
                            Background="#F0111820"
                            BorderBrush="#263B5264"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="10" Opacity="0.36" Color="#050B10" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding CalendarMonthText}"
                                               Foreground="#F6FBFF"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ClockText}"
                                               Foreground="#91AFC4"
                                               FontSize="12"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="38"
                                        Height="38"
                                        CornerRadius="19"
                                        Background="#1B6FD6FF">
                                    <TextBlock Text="&#xE787;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="17"
                                               Foreground="#EAF7FF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <UniformGrid Columns="7">
                                    <TextBlock Text="S" Style="{StaticResource CalendarHeaderText}" />
                                    <TextBlock Text="M" Style="{StaticResource CalendarHeaderText}" />
                                    <TextBlock Text="T" Style="{StaticResource CalendarHeaderText}" />
                                    <TextBlock Text="W" Style="{StaticResource CalendarHeaderText}" />
                                    <TextBlock Text="T" Style="{StaticResource CalendarHeaderText}" />
                                    <TextBlock Text="F" Style="{StaticResource CalendarHeaderText}" />
                                    <TextBlock Text="S" Style="{StaticResource CalendarHeaderText}" />
                                </UniformGrid>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding CalendarDays}" Margin="0,6,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="DayCell"
                                                    Width="34"
                                                    Height="30"
                                                    CornerRadius="8"
                                                    Margin="3"
                                                    Background="Transparent">
                                                <TextBlock Text="{Binding Day}"
                                                           Foreground="#E9F5FF"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                    <Setter TargetName="DayCell" Property="Opacity" Value="0.34" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="DayCell" Property="Background" Value="#D7228DFF" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <Border Grid.Row="2"
                                    Margin="0,14,0,0"
                                    CornerRadius="10"
                                    Background="#58111B25"
                                    BorderBrush="#1DFFFFFF"
                                    BorderThickness="1"
                                    Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="London"
                                                   Foreground="#8FA8BA"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding LondonTimeText}"
                                                   Foreground="#F2FAFF"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <TextBlock Text="Mumbai"
                                                   Foreground="#8FA8BA"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding MumbaiTimeText}"
                                                   Foreground="#F2FAFF"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </Grid>
</Window>
