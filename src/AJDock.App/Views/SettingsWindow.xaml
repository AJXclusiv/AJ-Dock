<Window x:Class="AJDock.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AJ Dock Settings"
        Width="920"
        Height="620"
        MinWidth="820"
        MinHeight="540"
        Icon="/Assets/AJDock.ico"
        WindowStartupLocation="CenterOwner"
        Background="#0B1116">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#101920" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#17222B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2C92FF" />
        <SolidColorBrush x:Key="TextBrush" Color="#F5F9FF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#AAB7C6" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Height="38" CornerRadius="6" Padding="12,0" Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons" Width="24" Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#264B8DFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#172C4058" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="#F5F9FF" />
            <Setter Property="Background" Value="#1D2A34" />
            <Setter Property="BorderBrush" Value="#334D6173" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#1B2730"
                                                BorderBrush="#334D6173"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="10,0">
                                            <Grid>
                                                <ContentPresenter HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <TextBlock Text="&#xE70D;"
                                                           FontFamily="Segoe Fluent Icons"
                                                           Foreground="#B7C6D6"
                                                           FontSize="10"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="#F018242D"
                                        BorderBrush="#405D7182"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F5F9FF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemRoot" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#264B8DFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" Background="#2B8BFF" CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" Background="#33424D56" CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#8CC6FF" Stroke="#CDEAFF" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="15"
                                    Height="15"
                                    CornerRadius="3"
                                    BorderBrush="#7B9AB3C9"
                                    BorderThickness="1"
                                    Background="#172630"
                                    Margin="0,0,8,0">
                                <TextBlock x:Name="Check"
                                           Text="&#xE73E;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="10"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#2B8BFF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#7CC6FF" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="#F5F9FF" />
            <Setter Property="CaretBrush" Value="#8CC6FF" />
            <Setter Property="Background" Value="#1B2730" />
            <Setter Property="BorderBrush" Value="#334D6173" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ApplyButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Background" Value="#2A333B" />
            <Setter Property="Foreground" Value="#F7FAFF" />
            <Setter Property="BorderBrush" Value="#405B6C7B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="0"
            Background="#F00C141A"
            BorderBrush="#355E7385"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#C8080E12">
                <TextBlock Text="AJ Dock Settings"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0" />
                <Button Content="Close"
                        HorizontalAlignment="Right"
                        Width="72"
                        Height="24"
                        Margin="0,5,12,5"
                        Style="{StaticResource ApplyButton}"
                        Click="Close_Click" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="148" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#D70B151A"
                        BorderBrush="#244B5C6A"
                        BorderThickness="0,0,1,0"
                        Padding="12">
                    <StackPanel>
                        <RadioButton Content="General" Uid="General" Tag="&#xE80F;" Style="{StaticResource NavItemStyle}" IsChecked="True" Checked="Section_Checked" />
                        <RadioButton Content="Appearance" Uid="Appearance" Tag="&#xE790;" Style="{StaticResource NavItemStyle}" Checked="Section_Checked" />
                        <RadioButton Content="Behavior" Uid="Behavior" Tag="&#xE8EE;" Style="{StaticResource NavItemStyle}" Checked="Section_Checked" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Column="1" Padding="28,24" VerticalScrollBarVisibility="Hidden">
                    <Grid>
                    <StackPanel x:Name="GeneralPanel">
                        <TextBlock Text="General" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Position" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource SettingsComboBox}"
                                      ItemsSource="{Binding DockPositions}"
                                      SelectedItem="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Icon Size" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="24" Maximum="96" TickFrequency="2" Value="{Binding IconSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="{Binding IconSize, StringFormat={}{0:F0} px}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Icon Quality" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0.4" Maximum="1" TickFrequency="0.05" Value="{Binding IconQuality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="{Binding IconQuality, StringFormat={}{0:P0}}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dock Size" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="32" Maximum="120" TickFrequency="2" Value="{Binding DockSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="{Binding DockSize, StringFormat={}{0:F0} px}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Icon Spacing" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="2" Maximum="32" TickFrequency="1" Value="{Binding IconSpacing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="{Binding IconSpacing, StringFormat={}{0:F0} px}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Magnification" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="1" Maximum="2.5" TickFrequency="0.05" Value="{Binding MagnificationAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="{Binding MagnificationAmount, StringFormat={}{0:P0}}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Animation Speed" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="50" Maximum="600" TickFrequency="10" Value="{Binding AnimationSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="Fast" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Audio Line" VerticalAlignment="Center" />
                            <Slider Grid.Column="1"
                                    Minimum="0.2"
                                    Maximum="1.5"
                                    TickFrequency="0.05"
                                    Value="{Binding AudioVisualizerSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding AudioVisualizerSensitivity, StringFormat={}{0:P0}}"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right" />
                        </Grid>

                        <Border Height="1" Background="#255A6D7E" Margin="0,12,0,12" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="AJ Default Baseline" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Restore layout, visuals, behavior, clock, and audio line to your base setup."
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,18,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Restore Defaults"
                                    Style="{StaticResource ApplyButton}"
                                    Command="{Binding RestoreAjDefaultsCommand}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <CheckBox Content="Auto Hide" IsChecked="{Binding AutoHide, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="Always On Top" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="Hide Windows Taskbar" IsChecked="{Binding HideWindowsTaskbar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Border Height="1" Background="#255A6D7E" Margin="0,16,0,14" />
                        <TextBlock Text="Date &amp; Time" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <UniformGrid Columns="2" Rows="3">
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="Display" Foreground="{StaticResource MutedBrush}" />
                                <ComboBox Style="{StaticResource SettingsComboBox}" ItemsSource="{Binding ClockDisplayModes}" SelectedItem="{Binding ClockDisplayMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Separator" Foreground="{StaticResource MutedBrush}" />
                                <ComboBox Style="{StaticResource SettingsComboBox}" ItemsSource="{Binding ClockSeparators}" SelectedItem="{Binding ClockSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="Date Format" Foreground="{StaticResource MutedBrush}" />
                                <ComboBox Style="{StaticResource SettingsComboBox}" ItemsSource="{Binding DateFormats}" SelectedItem="{Binding DateFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <CheckBox Content="24-hour clock" IsChecked="{Binding Use24HourClock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Show seconds" IsChecked="{Binding ShowSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>

                    </StackPanel>
                    <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                        <TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18" />
                        <TextBlock Text="Glass, transparency, blur, radius, shadow, and offset controls are active in the preview column." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />
                        <TextBlock Text="Presets" Foreground="{StaticResource MutedBrush}" />
                        <ItemsControl ItemsSource="{Binding ThemePresetNames}" Margin="0,8,0,18">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Style="{StaticResource ApplyButton}"
                                            Command="{Binding DataContext.ApplyThemePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,8,8"
                                            MinWidth="96" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Theme" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox Style="{StaticResource SettingsComboBox}" ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding ThemeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,18" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dock Color" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding DockColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding DockColorPresets}" Margin="0,0,0,18">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="34"
                                            Height="24"
                                            Margin="0,0,8,0"
                                            Command="{Binding DataContext.SetDockColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="6"
                                                        BorderBrush="#55FFFFFF"
                                                        BorderThickness="1"
                                                        Background="{Binding}" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox Content="Transparent dock background" IsChecked="True" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel x:Name="IconsPanel" Visibility="Collapsed">
                        <TextBlock Text="Icons" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18" />
                        <TextBlock Text="Icon size, spacing, custom icons, and same-application stacking are enabled." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Icon Size" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="24" Maximum="96" TickFrequency="2" Value="{Binding IconSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="{Binding IconSize, StringFormat={}{0:F0} px}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Icon Quality" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0.4" Maximum="1" TickFrequency="0.05" Value="{Binding IconQuality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="{Binding IconQuality, StringFormat={}{0:P0}}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="BehaviorPanel" Visibility="Collapsed">
                        <TextBlock Text="Behavior" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18" />
                        <Border CornerRadius="8"
                                Background="#182635"
                                BorderBrush="#335B7EA0"
                                BorderThickness="1"
                                Padding="14"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="AJ Dock Takeover" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DockTakeoverModeStatus}"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,18,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding DockTakeoverModeText}"
                                        Style="{StaticResource ApplyButton}"
                                        Command="{Binding ToggleDockTakeoverModeCommand}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <CheckBox Content="Auto Hide" IsChecked="{Binding AutoHide, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="Always On Top" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="Hide Windows Taskbar" IsChecked="{Binding HideWindowsTaskbar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel x:Name="ShortcutsPanel" Visibility="Collapsed">
                        <TextBlock Text="Shortcuts" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18" />
                        <TextBlock Text="Shortcut configuration surface is ready for keyboard shortcuts and dock actions." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">
                        <TextBlock Text="Advanced" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18" />
                        <TextBlock Text="Advanced options for monitors, window tracking, and integrations will live here." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                        <TextBlock Text="About" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18" />
                        <TextBlock Text="AJ Dock" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Clean. Powerful. Yours." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Column="2"
                        Background="#A50B1218"
                        BorderBrush="#2B5A6D7E"
                        BorderThickness="1,0,0,0"
                        Padding="22,24">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel>
                            <TextBlock Text="Preview" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <Border Height="124"
                                    CornerRadius="7"
                                    BorderBrush="#486D8798"
                                    BorderThickness="1"
                                    Margin="0,0,0,16"
                                    ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#386B95" Offset="0" />
                                        <GradientStop Color="#101B24" Offset="0.52" />
                                        <GradientStop Color="#071016" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,0,18">
                                        <Border CornerRadius="9" Background="#A816222B" BorderBrush="#395D7485" BorderThickness="1" Padding="10,7">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,9,0" Foreground="#2DA5FF" />
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,9,0" Foreground="#F3C044" />
                                                <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,9,0" Foreground="#27B9F2" />
                                                <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,9,0" Foreground="#3194FF" />
                                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,9,0" Foreground="#91D6FF" />
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#AEB8C6" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Background" Foreground="{StaticResource MutedBrush}" />
                            <ComboBox Style="{StaticResource SettingsComboBox}" ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding ThemeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14" />

                            <TextBlock Text="Dock Color" Foreground="{StaticResource MutedBrush}" />
                            <TextBox Text="{Binding DockColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Transparency" />
                                <TextBlock Grid.Column="1" Text="{Binding Transparency, StringFormat={}{0:P0}}" Foreground="{StaticResource MutedBrush}" TextAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0" Maximum="1" TickFrequency="0.02" Value="{Binding Transparency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,12,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Blur" />
                                <TextBlock Grid.Column="1" Text="{Binding BlurAmount, StringFormat={}{0:F0}}" Foreground="{StaticResource MutedBrush}" TextAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0" Maximum="40" TickFrequency="1" Value="{Binding BlurAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,12,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Corner Radius" />
                                <TextBlock Grid.Column="1" Text="{Binding CornerRadius, StringFormat={}{0:F0} px}" Foreground="{StaticResource MutedBrush}" TextAlignment="Right" />
                            </Grid>
                            <Slider Minimum="8" Maximum="28" TickFrequency="1" Value="{Binding CornerRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,12,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Edge Offset" />
                                <TextBlock Grid.Column="1" Text="{Binding DockOffset, StringFormat={}{0:F0} px}" Foreground="{StaticResource MutedBrush}" TextAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0" Maximum="96" TickFrequency="2" Value="{Binding DockOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button Content="Restore Defaults"
                                        Style="{StaticResource ApplyButton}"
                                        Command="{Binding RestoreAjDefaultsCommand}"
                                        Margin="0,0,8,0" />
                                <Button Content="Apply" Style="{StaticResource ApplyButton}" Click="Close_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
